{
  "name": "ikear-mobile",
  "version": "1.0.0",
  "description": "IKEAR — 二手家具 C2C 集市 iOS/Android + Web app (React Native + Expo, Supabase-ready)",
  "main": "index.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --test --experimental-strip-types --experimental-loader ./test/loader.mjs --import ./test/setup.ts \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "ci:check": "tsc --noEmit && npm test",
    "build:ios": "expo prebuild --platform ios",
    "build:android": "expo prebuild --platform android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.11.0",
    "expo": "~51.0.28",
    "expo-image-picker": "~15.0.7",
    "expo-local-authentication": "~14.0.1",
    "expo-status-bar": "~1.12.1",
    "lucide-react-native": "^0.408.0",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "~3.31.1",
    "zustand": "^4.5.4",
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.79",
    "@types/react-native": "^0.73.0",
    "typescript": "~5.3.3"
  },
  "private": true
}
